# Copy to .env (or point IVA_ENV_FILE at a file outside the repo). Never commit real values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Iva's own hot wallet on 0G mainnet (chain 16661). Small balances only.
IVA_ADDRESS=
IVA_PRIVATE_KEY=

# 0G Router (pc.0g.ai) keys for Iva's account
# sk- inference key, created with a daily credit_limit = the hard spend cap
ZG_API_KEY=
# mk- management key with account:read + keys:read (lets Iva read her own balance)
ZG_MGMT_KEY=

# Where surplus earnings go (the deployer / creator wallet)
CREATOR_ADDRESS=

# Public URL of web/pay.html and the bot username (for deep links back to Telegram)
PAY_PAGE_URL=
TELEGRAM_BOT_USERNAME=
